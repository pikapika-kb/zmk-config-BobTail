        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
&kp Q             &kp W             &kp E             &kp R             &kp T                                                 &kp Y             &kp U             &kp I             &kp O             &kp P
&kp A             &ht_lq NUM S      &kp D             &kp F             &kp G             &none               &kp BSPC          &kp H             &kp J             &kp K             &kp L             &ht_rq MOUSE SEMI
&kp Z             &kp X             &kp C             &kp V             &kp B             &kp COMMA           &kp DOT           &kp N             &kp M             &kp COMMA         &kp DOT           &kp SLASH
&kp LSHIFT        &kp LALT          &kp DEL           &none             &none             &kp SPACE           &kp ENTER         &to_kana          &kp LCTRL
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        num_layer {
            display-name = "Number";
            bindings = <
&trans            &trans            &trans            &trans            &trans                                                &kp N1            &kp N2            &kp N3            &kp N4            &kp N5
&trans            &trans            &trans            &trans            &trans            &trans              &trans            &kp N6            &kp N7            &kp N8            &kp N9            &kp N0

&trans            &trans            &trans            &trans            &trans            &trans              &trans            &k_xwa            &none             &none             &none             &none
&trans            &trans            &trans            &trans            &trans            &trans              &trans            &trans            &trans
            >;
        };

        daku_layer {
            display-name = "Dakuten";
            bindings = <
&k_go             &k_ge             &k_gu             &k_gi             &k_ga                                                 &trans            &trans            &trans            &trans            &trans
&k_zo             &k_ze             &k_zu             &k_zi             &k_za             &trans              &trans            &trans            &trans            &trans            &trans            &trans
&k_do             &k_de             &k_du             &k_di             &k_da             &trans              &trans            &trans            &trans            &trans            &trans            &trans
&k_bo             &k_be             &k_bu             &k_bi             &k_ba             &trans              &trans            &trans            &trans
            >;
        };

        handaku_layer {
            display-name = "Handakuten";
            bindings = <
&trans            &trans            &trans            &trans            &trans                                                &trans            &trans            &trans            &trans            &trans
&trans            &trans            &trans            &trans            &trans            &trans              &trans            &trans            &trans            &trans            &trans            &trans
&trans            &trans            &trans            &trans            &trans            &trans              &trans            &trans            &trans            &trans            &trans            &trans
&k_po             &k_pe             &k_pu             &k_pi             &k_pa             &trans              &trans            &trans            &trans
            >;
        };

        kctrl_layer {
            display-name = "Ctrl";
            bindings = <
&kp Q             &kp W             &kp E             &kp R             &kp T                                                 &kp Y             &kp U             &kp I             &kp O             &kp P
&kp A             &kp S             &kp D             &kp F             &kp G             &trans              &trans            &kp H             &kp J             &kp K             &kp L             &kp SEMI
&kp Z             &kp X             &kp C             &kp V             &kp B             &trans              &trans            &kp N             &kp M             &kp COMMA         &kp DOT           &kp SLASH
&trans            &trans            &trans            &trans            &trans            &trans              &trans            &trans            &trans
            >;

    combos {
        compatible = "zmk,combos";

        /* 右手2段目の横の同時押し */
        c_nn {
            bindings = <&k_nn>;
            key-positions = <17 18>;   /* な+に = ん */
            layers = <KANA>;
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
        };
        c_xtu {
            bindings = <&k_xtu>;
            key-positions = <18 19>;   /* に+ぬ = っ */
            layers = <KANA>;
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
        };
        c_choon {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;   /* ぬ+ね = ー */
            layers = <KANA>;
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
        };

        /* 右手中指の列の縦の同時押し */
        c_kakko_l {
            bindings = <&kp LBKT>;
            key-positions = <6 18>;    /* い+に = 「 */
            layers = <KANA>;
            timeout-ms = <50>;
        };
        c_kakko_r {
            bindings = <&kp RBKT>;
            key-positions = <18 30>;   /* に+み = 」 */
            layers = <KANA>;
            timeout-ms = <50>;
        };

        /* 左親指 、+Space = Tab */
        c_tab {
            bindings = <&kp TAB>;
            key-positions = <27 39>;
            layers = <KANA QWERTY>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        kana_layer {
            display-name = "Kana";
            bindings = <
&k_ko             &k_ke             &k_ku             &k_ki             &k_ka                                                 &k_a              &k_i              &k_u              &k_e              &k_o
&k_so             &ht_se YRW 0      &ht_su SMALLA 0   &ht_si SMALLY 0   &k_sa             &none               &kp BSPC          &k_na             &k_ni             &k_nu             &k_ne             &ht_no MOUSE 0
&k_to             &k_te             &k_tu             &k_ti             &k_ta             &kp COMMA           &ht_r HANDAKU DOT  &k_ma             &k_mi             &k_mu             &k_me             &k_mo
&ht_ho LSHIFT 0   &k_he             &k_hu             &k_hi             &k_ha             &kp SPACE           &ht_r DAKU ENTER  &to_qwerty        &ctl_kana
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        yrw_layer {
            display-name = "Ya-Ra-Wa";
            bindings = <
&trans            &trans            &trans            &trans            &trans                                                &k_ya             &k_i              &k_yu             &k_e              &k_yo

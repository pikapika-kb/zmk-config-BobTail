/*
 * BobTail / BobTail ESC  五十音かな配列
 * 1層目: 左手に か・さ・た・は行、右手に あ・な・ま行(人差し指→小指外側)
 * かなキーは IME(ローマ字入力)にローマ字を送るマクロです。
 * 設計の経緯は claude.ai での相談(2026-11-02)によります。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define KANA 0
#define YRW 1
#define SMALLA 2
#define SMALLY 3
#define DAKU 4
#define HANDAKU 5
#define KCTRL 6
#define QWERTY 7
#define NUM 8
#define MOUSE 9
#define SCROLL 10

#define LEFT_KEYS 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39
#define RIGHT_KEYS 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42

/ {
    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };

        /* 左手の長押しキー(せ・す・し): 押している間、右手が別の層になる */
        ht_se: ht_se {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release;
            bindings = <&mo>, <&k_se>;
        };
        ht_su: ht_su {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release;
            bindings = <&mo>, <&k_su>;
        };
        ht_si: ht_si {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release;
            bindings = <&mo>, <&k_si>;
        };

        /* ほ: 長押しで Shift */
        ht_ho: ht_ho {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&k_ho>;
        };

        /* qwerty 層の S: 長押しで数字の層 */
        ht_lq: ht_lq {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release;
            bindings = <&mo>, <&kp>;
        };

        /* 右小指外側の中段(の / ;): 長押ししている間マウス層。トラックボールのクリック・スクロール用 */
        ht_no: ht_no {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&k_no>;
        };
        ht_rq: ht_rq {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        /* 右親指(Enter・。): 長押しで濁点・半濁点の層。左手のキーとの組み合わせでだけ長押しになる */
        ht_r: ht_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <LEFT_KEYS>;
            hold-trigger-on-release;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        /* Ctrl を押している間、qwerty の位置で Ctrl+文字(て=X, つ=C, ち=V, た=B など) */
        ctl_kana: ctl_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo KCTRL &kp LCTRL>
                , <&macro_pause_for_release>
                , <&macro_release &mo KCTRL &kp LCTRL>
                ;
        };

        /* かな層 → qwerty 層(IME オフ) */
        to_qwerty: to_qwerty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LANG2 &to QWERTY>;
        };

        /* qwerty 層 → かな層(IME オン) */
        to_kana: to_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LANG1 &to KANA>;
        };

        /* かな(ローマ字マクロ) */
        k_a: k_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp A>;
